{
  "manifest_version": 3,
  "name": "4th&Go — Sleeper Draft Board",
  "version": "1.0.0",
  "description": "Your tiered rankings, auto-synced to a live Sleeper draft. Players get crossed off as picks come in.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://api.sleeper.app/*", "https://sleeper.com/*"],
  "action": {
    "default_title": "Open draft board"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
